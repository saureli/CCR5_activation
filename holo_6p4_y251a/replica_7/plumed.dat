ecv: ECV_MULTITHERMAL ARG=ene TEMP_MAX=335 TEMP_STEPS=40
opesX: OPES_EXPANDED ARG=ecv.* FILE=DeltaFs.data PACE=10000 UPDATE_FROM=5000


PRINT ARG=* FILE=COLVAR STRIDE=500 FMT=%8.4f
