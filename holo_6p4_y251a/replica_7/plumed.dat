# Activation path
p1: PATHMSD REFERENCE=final_path_5fix.pdb LAMBDA=90
uwallZ: UPPER_WALLS ARG=p1.zzz AT=0.15 KAPPA=2500 EXP=2 EPS=1 OFFSET=0
lwallS: LOWER_WALLS ARG=p1.sss AT=1.3 KAPPA=5000 EXP=2 EPS=1 OFFSET=0
szparab: CUSTOM ARG=p1.sss,p1.zzz FUNC=y+(0.005*(x-4)^2)-0.1 PERIODIC=NO
# uwallsz: UPPER_WALLS ARG=szparab AT=0 KAPPA=200000 EXP=2 EPS=1 OFFSET=0

# Reference RMSDs
r1: RMSD REFERENCE=7o7f.TM_CA.pdb TYPE=OPTIMAL
r2: RMSD REFERENCE=inactive_TM_CA.pdb TYPE=OPTIMAL

# PIY microswitch
# CCR5 residue labels give the sequence position followed by the GPCRdb generic number.
SC116: CENTER ATOMS=1635,1637,1641,1644   # I116 (3x40)
SC206: CENTER ATOMS=3121,3124,3127    # P206 (5x50)
SC244: CENTER ATOMS=3796,3799,3800,3802,3804,3805,3807,3809   # Y244 (6x44)
SC107: CENTER ATOMS=1491,1494,1496,1500  # L107 (3x31)
i116-p206: DISTANCE ATOMS=SC116,SC206
i116-p244: DISTANCE ATOMS=SC116,SC244
p206-y244: DISTANCE ATOMS=SC206,SC244
y244-p107: DISTANCE ATOMS=SC244,SC107
PIF1-path: CUSTOM ARG=p1.sss,i116-p206 FUNC=y+(0.0013*(x^2))-0.62 PERIODIC=NO
PIF2-path: CUSTOM ARG=p1.sss,i116-p244 FUNC=y-(0.0018*(x^2))-0.55 PERIODIC=NO
PIF3-path: CUSTOM ARG=p1.sss,p206-y244 FUNC=y+(0.0015*(x^2))-0.61 PERIODIC=NO
uwallPIF: UPPER_WALLS ARG=PIF1-path,PIF2-path,PIF3-path AT=0,0,0 KAPPA=5000,5000,5000 EXP=2,2,2 EPS=1,1,1 OFFSET=0,0,0

# NPxxY microswitch
SC214: CENTER ATOMS=3255,3258,3259,3261,3263,3264,3266,3268   # Y214 (5x58)
SC293: CENTER ATOMS=4559,4561,4564,4565   # N293 (7x49)
SC297: CENTER ATOMS=4627,4630,4631,4633,4635,4636,4638,4640   # Y297 (7x53)
SC69: CENTER ATOMS=893,896,898,902  # L69 (2x43)
y214-y297: DISTANCE ATOMS=SC214,SC297
y214-n293: DISTANCE ATOMS=SC214,SC293
y214-y297-path: CUSTOM ARG=p1.sss,y214-y297 FUNC=y+(0.0146*(x^2))-1.56 PERIODIC=NO
uwallNPxxY: UPPER_WALLS ARG=y214-y297-path AT=0 KAPPA=5000 EXP=2 EPS=1 OFFSET=0

# DRY microswitch
SC126: CENTER ATOMS=1815,1818,1821,1824,1826,1827,1830  # R126 (3x50)
BB230: CENTER ATOMS=3534,3536,3556,3557  # R230 (6x30)
r126-y214: DISTANCE ATOMS=SC126,SC214
r126-r230: DISTANCE ATOMS=SC126,BB230
y297-l69: DISTANCE ATOMS=SC297,SC69
r126-y214-path: CUSTOM ARG=p1.sss,r126-y214 FUNC=y+(0.0044*(x^2))-0.84 PERIODIC=NO
uwallDRY: UPPER_WALLS ARG=r126-y214-path AT=0 KAPPA=5000 EXP=2 EPS=1 OFFSET=0

WO: GROUP ATOMS=48884-75556:4  # Water oxygen atoms
yycenter1: CENTER ATOMS=1694,3731,4647 # Center for water coordination
yywo: COORDINATION GROUPA=yycenter1 GROUPB=WO SWITCH={RATIONAL D_0=0 R_0=0.30 NN=2 MM=6 D_MAX=1.0} NLIST NL_CUTOFF=1.5 NL_STRIDE=50
con214: COORDINATION GROUPA=SC214 GROUPB=SC297 SWITCH={RATIONAL D_0=0 R_0=0.90 NN=8 MM=12}
yywoprod: CUSTOM ARG=yywo,con214 FUNC=x*y PERIODIC=NO
yywosum: CUSTOM ARG=yywo,con214 FUNC=x+y PERIODIC=NO

ene: ENERGY
vol: VOLUME
intene: CUSTOM PERIODIC=NO ARG=ene,vol FUNC=x+0.06022140857*y

OPES_METAD_EXPLORE ...
  LABEL=opes
  ARG=p1.sss
  SIGMA=0.05
  FILE=Kernels.data
  STATE_WFILE=compressed14.Kernels
  PACE=50000
  BARRIER=100
... OPES_METAD_EXPLORE

